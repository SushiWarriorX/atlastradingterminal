# Copy to .env (gitignored) and fill in what you want to use. Everything is optional:
# with nothing set, the app runs on built-in demo data.

# --- Strava (official API) -------------------------------------------------
# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Garmin Connect (unofficial; personal use only) -------------------------
# Used by the server to sign in. Accounts with MFA enabled are not supported.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Server ------------------------------------------------------------------
PORT=8787
# Where the browser app lives in development (OAuth redirects back here).
# APP_ORIGIN=http://localhost:5173
