{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../tests/**/*.integration.test.ts"
  ]
}
