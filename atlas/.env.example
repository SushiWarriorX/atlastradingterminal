# --- Backend (atlas/backend). Secrets stay server-side; nothing here is bundled into the frontend. ---
ATLAS_DEMO=0                 # 1 = synthetic data, labeled DEMO everywhere. Never silently enabled.
ATLAS_DB=atlas.db            # SQLite file (Tier 1). Postgres/Timescale is on the roadmap.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
ANTHROPIC_API_KEY=           # enables the AI Research Desk. Empty = AI shows "not configured".
ATLAS_MODEL=claude-sonnet-5-5
ATLAS_ALERT_LOOP=1           # background alert evaluation (set 0 to disable)
ATLAS_ALERT_SECONDS=30       # how often alerts are checked
ATLAS_PAPER_LOOP=1           # background paper-order fill loop (set 0 to disable)
ATLAS_PAPER_SECONDS=5        # how often open paper orders are evaluated

# --- Telegram alert delivery (optional). Both must be set to enable it; they never leave the backend. ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # your chat id (message the bot once, then e.g. ask @userinfobot)
# ATLAS_TELEGRAM_ALLOW_DEMO=1   # also send alerts based on DEMO data (off by default: synthetic data should not reach your phone)
# TELEGRAM_API_BASE=            # self-hosted Bot API server / test double (default https://api.telegram.org)
# HYPERLIQUID_API_BASE=         # test double / proxy for the public info endpoint (default https://api.hyperliquid.xyz). Public addresses only: never a private key
# ATLAS_NEWS_SECONDS=900          # RSS poll interval; ATLAS_NEWS_LOOP=0 disables polling (default off in DEMO mode)
# ATLAS_DERIV_SECONDS=300         # BTC derivatives polling interval (history for percentiles); ATLAS_DERIV_LOOP=0 disables (default off in DEMO mode)
# ATLAS_NEWS_USER_AGENT=        # identify yourself to feeds that require it, e.g. "ATLAS (you@example.com)" (the SEC asks for this)
# ATLAS_NEWS_ALLOW_LOCAL=1      # test only: allow loopback feed URLs

# --- Interactive Brokers (optional; needs TWS or IB Gateway running locally with the API enabled) ---
IBKR_ENABLED=0
# IBKR_AUTOCONNECT=1          # connect to a running TWS/Gateway by itself and reconnect after its daily logout (IBKR_RECONNECT_SECONDS=30)
# ATLAS_IBKR_DATA=0            # 1 = prefer IBKR market data for US stocks/ETFs while connected (read-only; Yahoo is the labelled fallback)
IBKR_MODE=readonly           # readonly: any account, positions/executions only. paper_trading: orders to PAPER accounts only. There is no live mode.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497               # paper: 7497 (TWS) / 4002 (Gateway). paper_trading mode refuses the live ports 7496 / 4001.
IBKR_CLIENT_ID=21
# IBKR_ACCOUNT=              # optional: pick one account when several are managed

# --- Planned integrations: NOT read by any code yet (see docs/data-providers.md) ---
# MASSIVE_API_KEY=           # Tier 2: real-time US equities (Massive, formerly Polygon.io)
# ALPACA_KEY_ID= / ALPACA_SECRET=   # Alpaca market data + paper trading
# COINGLASS_API_KEY=         # Phase 7: BTC derivatives (funding, OI, liquidations)
# FRED_API_KEY=              # Phase 5: ALFRED vintages and the FRED JSON API (the CSV endpoint used today needs no key)
# BENZINGA_API_KEY=          # Phase 4: licensed news

# SEC EDGAR (free, official filings for the stock research page). The SEC asks every automated client to identify itself with a contact email.
# Leave empty to keep EDGAR off; the page then says so. Never commit your real address.
ATLAS_SEC_CONTACT=
