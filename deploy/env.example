# Copy to .env in the project folder on the server:  cp deploy/env.example .env   then edit.   chmod 600 .env
# This file is never committed. Do not share it.

# The web address people type. Use your own domain, or a free one like 203-0-113-5.sslip.io (your server's IP with dashes).
ATLAS_DOMAIN=atlas.example.com

# Your login password: at least 12 characters. Generate one with:  openssl rand -base64 18
ATLAS_AUTH_PASSWORD=change-me-to-a-long-random-password

# Optional: AI Research Desk. Leave blank to keep the AI off.
ANTHROPIC_API_KEY=
